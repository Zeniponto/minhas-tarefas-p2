{
  "rules": {
    ".read": false,
    ".write": false,
    "tarefas": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid",
        "$tarefaId": {
          ".validate": "newData.hasChildren(['id', 'titulo', 'descricao', 'dataVencimento', 'prioridade', 'concluida'])",
          "id": {
            ".validate": "newData.isString() && newData.val() === $tarefaId"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "descricao": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "dataVencimento": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "prioridade": {
            ".validate": "newData.val() === 'Baixa' || newData.val() === 'Média' || newData.val() === 'Alta'"
          },
          "concluida": {
            ".validate": "newData.isBoolean()"
          },
          "$outro": {
            ".validate": false
          }
        }
      }
    }
  }
}
